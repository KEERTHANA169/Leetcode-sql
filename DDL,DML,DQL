CREATE DATABASE primaryAndForeignKey;
USE primaryAndForeignKey;
CREATE TABLE Students(
student_id INT PRIMARY KEY,
name VARCHAR(20) NOT NULL,
email VARCHAR(30) UNIQUE,
age INT CHECK (age>=18),
gender VARCHAR(20) DEFAULT 'Not Specified');
CREATE TABLE Courses(
course_id INT PRIMARY KEY,
course_name VARCHAR(50) NOT NULL,
fee INT CHECK(fee>0),
duration INT DEFAULT '6');
CREATE TABLE Enrollments(
enroll_id INT PRIMARY KEY,
student_id INT,
course_id INT,
Grade VARCHAR(10),
CONSTRAINT fk1 FOREIGN KEY (student_id) REFERENCES Students(student_id),
Constraint fk2 FOREIGN KEY (course_id) REFERENCES Courses(course_id));

